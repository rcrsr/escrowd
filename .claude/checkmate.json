{
  "environments": [
    {
      "name": "conduct",
      "paths": [
        "conduct"
      ],
      "checks": {
        ".md": [
          {
            "name": "conduct",
            "command": "node",
            "args": [
              "conduct/resources/scripts/validate-documents.mjs",
              "--file",
              "$FILE",
              "--json"
            ],
            "parser": "jsonl",
            "_conduct": true
          }
        ]
      },
      "_conduct": true
    },
    {
      "name": "codanna-settings",
      "paths": [
        ".codanna"
      ],
      "checks": {
        ".toml": [
          {
            "name": "codanna-settings",
            "command": "node",
            "args": [
              "conduct/resources/scripts/check-codanna-settings.mjs",
              "--file",
              "$FILE",
              "--json"
            ],
            "parser": "jsonl",
            "_conduct": true
          }
        ]
      },
      "_conduct": true
    },
    {
      "name": "python-sdk",
      "paths": [
        "sdk/python/src"
      ],
      "exclude": [
        "sdk/python/src/escrow/v1/**"
      ],
      "checks": {
        ".py": [
          {
            "name": "ruff format",
            "command": "uv",
            "args": [
              "run",
              "--project",
              "sdk/python",
              "--frozen",
              "ruff",
              "format",
              "--check",
              "$FILE"
            ],
            "parser": "prettier",
            "_auto": true
          },
          {
            "name": "ruff check",
            "command": "uv",
            "args": [
              "run",
              "--project",
              "sdk/python",
              "--frozen",
              "ruff",
              "check",
              "--output-format=concise",
              "$FILE"
            ],
            "parser": "ruff",
            "_auto": true
          },
          {
            "name": "ty",
            "command": "uv",
            "args": [
              "run",
              "--project",
              "sdk/python",
              "--frozen",
              "ty",
              "check",
              "--project",
              "sdk/python",
              "$FILE"
            ],
            "parser": "ty",
            "_auto": true
          }
        ]
      }
    },
    {
      "name": "root",
      "paths": [
        "."
      ],
      "exclude": [
        "spikes/**",
        "target/**",
        "**/.venv/**"
      ],
      "checks": {
        ".rs": [
          {
            "name": "rustfmt",
            "command": "rustfmt",
            "args": [
              "--check",
              "--edition",
              "2024",
              "$FILE"
            ],
            "parser": "prettier",
            "_auto": true
          }
        ],
        ".py": [
          {
            "name": "ruff format",
            "command": "uv",
            "args": [
              "run",
              "--project",
              "sdk/python",
              "--frozen",
              "ruff",
              "format",
              "--check",
              "$FILE"
            ],
            "parser": "prettier",
            "_auto": true
          },
          {
            "name": "ruff check",
            "command": "uv",
            "args": [
              "run",
              "--project",
              "sdk/python",
              "--frozen",
              "ruff",
              "check",
              "--output-format=concise",
              "$FILE"
            ],
            "parser": "ruff",
            "_auto": true
          }
        ],
        ".sh": [
          {
            "name": "shellcheck",
            "command": "shellcheck",
            "args": [
              "--format=gcc",
              "--severity=warning",
              "$FILE"
            ],
            "parser": "gcc",
            "_auto": true
          },
          {
            "name": "shfmt",
            "command": "shfmt",
            "args": [
              "-d",
              "-i",
              "2",
              "$FILE"
            ],
            "parser": "prettier",
            "_auto": true
          }
        ]
      }
    }
  ],
  "tasks": [
    {
      "name": "policy-reviewer",
      "match": "conduct:policy-engineer",
      "action": "review",
      "message": "Invoke conduct:policy-reviewer to validate the policy file.",
      "_conduct": true
    },
    {
      "name": "escrowd-code-reviewer",
      "match": "escrowd-engineer",
      "action": "review",
      "message": "Invoke escrowd-code-reviewer to validate the implementation.",
      "_conduct": true
    }
  ]
}
