{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "python-sdk",
  "projectType": "library",
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{workspaceRoot}/**/*.py",
        "{workspaceRoot}/ruff.toml",
        "{workspaceRoot}/libs/python-sdk/pyproject.toml",
        "{workspaceRoot}/libs/python-sdk/uv.lock",
        "{workspaceRoot}/libs/testkit/pyproject.toml",
        "{workspaceRoot}/.python-version",
        "{workspaceRoot}/mise.toml"
      ],
      "outputs": [],
      "options": {
        "parallel": false,
        "commands": [
          "uv run --frozen ruff check",
          "uv run --frozen ruff format --check",
          "uv run --frozen ty check --project libs/python-sdk"
        ]
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": false,
      "parallelism": false,
      "options": {
        "commands": ["libs/python-sdk/gen.sh && git diff --exit-code libs/python-sdk/src"]
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "parallel": false,
        "commands": [
          "uv build --package escrowd --wheel --out-dir dist",
          "python -m zipfile -l dist/*.whl | grep -q escrow/py.typed"
        ]
      }
    }
  }
}
