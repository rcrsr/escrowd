# escrowd's own bwrap, for Ubuntu's unprivileged user namespace restriction.
# Modeled on Ubuntu's bwrap-userns-restrict: bwrap itself may create a user
# namespace and mount; everything it executes is stacked with
# escrowd_unpriv_bwrap, which denies all capabilities, so sandboxed code cannot
# mount over the escrow view. abi 4.0 so it loads on Ubuntu 24.04 (AppArmor 4.0).

abi <abi/4.0>,

include <tunables/global>

profile escrowd_bwrap /usr/lib/escrowd/bwrap flags=(attach_disconnected,mediate_deleted) {
  allow capability,
  allow file rwlkm /{**,},
  allow network,
  allow unix,
  allow ptrace,
  allow signal,
  allow mqueue,
  allow io_uring,
  allow userns,
  allow mount,
  allow umount,
  allow pivot_root,
  allow dbus,

  # bwrap sets no-new-privs, so children must stack rather than transition.
  allow pix /** -> &escrowd_bwrap//&escrowd_unpriv_bwrap,
}

profile escrowd_unpriv_bwrap flags=(attach_disconnected,mediate_deleted) {
  allow file rwlkm /{**,},
  allow network,
  allow unix,
  allow ptrace,
  allow signal,
  allow mqueue,
  allow io_uring,
  allow userns,
  allow mount,
  allow umount,
  allow pivot_root,
  allow dbus,

  allow pix /** -> &escrowd_unpriv_bwrap,

  audit deny capability,
}
