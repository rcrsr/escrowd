# Copy to .env.local (git-ignored); mise loads it into every shell and task.
# ESCROW_BIN=target/release/escrow   # the binary the conformance suite and soaks run
# ESCROW_BWRAP=/usr/lib/escrowd/bwrap # bwrap the suite uses for its own sandboxes
# ESCROWD_PYTHON=3.11                 # run uv (and the suite) on another Python
# ESCROWD_FAULT=                      # fault-injection crash point (debug or fault-injection builds)
