{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "escrow-cli",
  "tags": [
    "type:app",
    "lang:rust"
  ],
  "targets": {
    "lint": {},
    "lint:fix": {},
    "format": {},
    "format:fix": {},
    "typecheck": {},
    "deps": {},
    "test": {},
    "test:coverage": {},
    "build": {},
    "build:debug": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo build --locked -p escrow-cli"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "command": "bash scripts/dev.sh"
      }
    }
  }
}
