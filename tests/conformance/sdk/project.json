{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "conformance-sdk",
  "tags": [
    "type:e2e",
    "lang:python"
  ],
  "implicitDependencies": [
    "escrow-cli",
    "python-sdk",
    "testkit"
  ],
  "targets": {
    "lint": {},
    "lint:fix": {},
    "format": {},
    "format:fix": {},
    "typecheck": {},
    "conformance": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --no-sync pytest -n 0 --rootdir tests/conformance tests/conformance/sdk"
      }
    }
  }
}
